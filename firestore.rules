rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function allowedUser() {
      return signedIn() &&
        request.auth.token.email in [
          'maxivivallo@gmail.com',
          'damirodriguez81@gmail.com'
        ];
    }

    function userId() {
      return request.auth.token.email == 'maxivivallo@gmail.com' ? 'maxi' : 'damian';
    }

    function canReadGasto() {
      return resource.data.esPrivado != true ||
        resource.data.owner == 'hogar' ||
        resource.data.owner == userId();
    }

    function canDeleteGasto() {
      return canReadGasto() ||
        resource.data.tipoReparto in ['comun', 'proporcional', 'devolucion'];
    }

    function canWriteGasto() {
      return request.resource.data.esPrivado != true ||
        request.resource.data.owner == userId();
    }

    function canEditVisibleGasto() {
      return resource.data.tipoReparto != 'privado' &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'categoria',
          'tipoReparto',
          'formato',
          'medioId',
          'periodo',
          'concepto'
        ]);
    }

    match /gastos/{gastoId} {
      allow list: if allowedUser();
      allow get: if allowedUser() && canReadGasto();
      allow create: if allowedUser() && canWriteGasto();
      allow update: if allowedUser() && (canWriteGasto() || canEditVisibleGasto());
      allow delete: if allowedUser() && canDeleteGasto();
    }

    match /tarjetas/{document} {
      allow read, write: if allowedUser();
    }

    match /cuentas/{document} {
      allow read, write: if allowedUser();
    }

    match /ingresos/{document} {
      allow read, write: if allowedUser();
    }

    match /traspasos_cuentas/{document} {
      allow read, write: if allowedUser();
    }

    match /pagos_tarjeta/{document} {
      allow read, write: if allowedUser();
    }

    match /ajustes_cuenta/{document} {
      allow read, write: if allowedUser();
    }

    match /cuotas_prestamo/{document} {
      allow read, write: if allowedUser();
    }

    match /configuracion/{document} {
      allow read, write: if allowedUser();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
